{
  "name": "llm-prompt-studio",
  "version": "1.6.2",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/doodersrage/llm-prompt-studio.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack -p 47832",
    "dev:fast": "next dev",
    "dev:analyze": "ANALYZE=true next dev --webpack -p 47832",
    "build": "next build",
    "postbuild": "node scripts/prune-standalone.mjs",
    "build:fast": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start -p 47832",
    "prepare": "husky",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && node scripts/check-client-server-imports.mjs",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "lint:boundaries": "node scripts/check-client-server-imports.mjs",
    "format": "prettier --write --cache --log-level error .",
    "format:check": "prettier --check --cache --log-level error .",
    "format:src": "prettier --write --cache --log-level error src/**/*.{ts,tsx,js,jsx}",
    "format:check:src": "prettier --check --cache --log-level error src/**/*.{ts,tsx,js,jsx}",
    "format:changed": "prettier --write --cache --ignore-unknown --log-level error .",
    "format:fast": "prettier --write --cache --log-level error --no-color src/**/*.{ts,tsx,js,jsx}",
    "format:check:fast": "prettier --check --cache --log-level error --no-color src/**/*.{ts,tsx,js,jsx}",
    "format:stats": "prettier --write --cache --log-level error --dry-run . | grep -E '(Formatted|Unchanged)' | wc -l",
    "perf:monitor": "node scripts/performance-monitor.mjs",
    "perf:test": "node scripts/performance-test.mjs",
    "locations:count": "node scripts/generate-locations.mjs --count",
    "locations:generate": "node scripts/generate-locations.mjs --add 500",
    "locations:generate:dry": "node scripts/generate-locations.mjs --add 500 --dry-run",
    "clothing:count": "node scripts/generate-clothing.mjs --count",
    "clothing:dedupe": "node scripts/dedupe-clothing.mjs",
    "clothing:generate": "node scripts/generate-clothing.mjs --add 500",
    "clothing:generate:dry": "node scripts/generate-clothing.mjs --add 500 --dry-run",
    "prompt:cli": "node scripts/qwen-prompt.mjs",
    "test": "node scripts/run-unit-tests.mjs && npm run compose:validate-exposed",
    "test:e2e": "playwright test",
    "docs:serve": "python -m mkdocs serve",
    "docs:build": "python -m mkdocs build",
    "test:e2e:gallery": "playwright test e2e/gallery-exact-replay.spec.ts e2e/gallery-interaction.spec.ts e2e/gallery-lightbox.spec.ts",
    "test:e2e:play": "playwright test e2e/play-campaign.spec.ts",
    "test:e2e:ops": "playwright test e2e/auth-queue-inpaint.spec.ts e2e/workflow-heal-auth.spec.ts --workers=1",
    "test:e2e:ops:auth": "PROMPT_E2E_AUTH=1 playwright test e2e/auth-queue-inpaint.spec.ts e2e/workflow-heal-auth.spec.ts --workers=1",
    "test:e2e:a11y": "playwright test e2e/accessibility.spec.ts",
    "compose:validate-exposed": "node scripts/validate-compose-exposed.mjs",
    "size": "size-limit --config size-limit.json && node scripts/check-shared-bundle-size.mjs",
    "desktop:dev": "node desktop/scripts/dev.mjs",
    "desktop:stage": "node desktop/scripts/stage-standalone.mjs",
    "desktop:node": "node desktop/scripts/fetch-node.mjs",
    "desktop:icons": "node desktop/scripts/generate-icons.mjs",
    "desktop:build": "node desktop/scripts/build.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@tanstack/react-virtual": "^3.14.7",
    "@xyflow/react": "^12.11.2",
    "critters": "^0.0.23",
    "dexie": "^4.4.4",
    "next": "^16.2.10",
    "nodemailer": "^9.0.3",
    "onnxruntime-web": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@size-limit/file": "^13.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "size-limit": "^13.0.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "ioredis": "^6.0.0"
  }
}
